DISCORD_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
CALL_PANEL_CHANNEL_ID=1546138567921639474
MEMECOIN_ALERT_CHANNEL_ID=1546138825628192900

DB_PATH=data/bot.db
ALERT_REFRESH_SECONDS=30

# GMGN CLI — install with: npm install -g gmgn-cli
GMGN_API_KEY=
GMGN_BASE_URL=https://openapi.gmgn.ai

SOCIAL_WINDOW_SECONDS=900
SOCIAL_SIGNAL_CACHE_SECONDS=30

# Pump.fun — requires API key + wallet funded with >= 0.02 SOL
PUMPPORTAL_API_KEY=

# FOMO — browser mode uses Playwright with persistent profile
FOMO_MODE=browser
FOMO_JWT=
FOMO_PROFILE_DIR=data/fomo-profile
FOMO_HEADLESS=false

# Smart Wallet Engine
SMART_WALLET_ENABLED=true
SMART_WALLET_MIN_SCORE=80
SMART_WALLET_MIN_TRADES=50
SMART_WALLET_MIN_ACTIVE_DAYS=30
SMART_WALLET_MIN_REALIZED_PNL=5000
SMART_WALLET_MIN_WIN_RATE=0.55
SMART_WALLET_ELITE_SCORE=90
SMART_WALLET_CACHE_MINUTES=30
SMART_WALLET_LOOKBACK_HOURS=24

# Discord Webhook for live alerts
